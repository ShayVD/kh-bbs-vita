#!/usr/bin/env bash
# Run a command inside the khbbs-toolchain container (tools/docker/toolchain.Dockerfile)
# with the repo mounted at /work and the same relative working directory.
#   tools/tc mips-linux-gnu-objdump -d build/probe/t.o
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
rel=${PWD#"$root"}
[[ "$rel" == "$PWD" ]] && rel=""
exec docker run --rm --platform linux/amd64 -v "$root:/work" -w "/work$rel" khbbs-toolchain "$@"
